{
  "$meta": {
    "name": "Creative Design Networks design tokens",
    "version": "1.0.0",
    "phase": "P1",
    "source": "CDN-MVP-IMPLEMENTATION-ROADMAP.md §10, §16, §17",
    "note": "SINGLE SOURCE OF TRUTH. Edited by hand; everything under src/lib/styles/*.generated.ts is built from this file by scripts/build-tokens.mjs and must never be edited directly. Run `npm run tokens` after changing anything here."
  },
  "color": {
    "ground": {
      "canvas": {
        "value": "#000000",
        "comment": "Map canvas ONLY. Pure black is what makes neon read as emission."
      },
      "background": {
        "value": "#07070C",
        "comment": "App background"
      },
      "surface": {
        "value": "#0D0E17",
        "comment": "Panels, sheets, cards"
      },
      "raised": {
        "value": "#161930",
        "comment": "Inputs, raised fills"
      },
      "border": {
        "value": "#22253A",
        "comment": "All hairlines"
      },
      "ink": {
        "value": "#EDEEF7",
        "comment": "All labels. Node labels are ALWAYS this, never the family hue."
      },
      "muted": {
        "value": "#8C8FA8",
        "comment": "Secondary text"
      }
    },
    "family": {
      "create": {
        "value": "#A3E635"
      },
      "discover": {
        "value": "#2FD9F5"
      },
      "services": {
        "value": "#FF8A3D"
      },
      "people": {
        "value": "#FF4D97"
      },
      "organise": {
        "value": "#8B5CF6"
      },
      "commerce": {
        "value": "#2DD4BF"
      }
    },
    "semantic": {
      "success": {
        "value": "#2DD4BF"
      },
      "warning": {
        "value": "#FFB020"
      },
      "danger": {
        "value": "#FF4D6D"
      },
      "focus": {
        "value": "#2FD9F5",
        "comment": "Focus ring is always cyan regardless of family, so it is never mistaken for family state."
      }
    }
  },
  "familyRamp": {
    "$comment": "Generated per family by build-tokens.mjs. core = stroke, glow = core at 55% for halos, wash = core at 8% for fills.",
    "glowAlpha": 0.55,
    "washAlpha": 0.08
  },
  "typography": {
    "face": {
      "display": {
        "stack": "var(--font-display, 'Chakra Petch'), 'Chakra Petch', system-ui, sans-serif",
        "comment": "Screen titles, node labels, brand chrome. Angular without costume sci-fi; legible at 12px on canvas. Served by next/font (src/lib/styles/fonts.ts); the var() resolves to the self-hosted file."
      },
      "body": {
        "stack": "var(--font-body, 'Inter'), 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "comment": "Descriptions, sheets, forms, chat. Neutral by design — the map carries the personality. Served by next/font (src/lib/styles/fonts.ts); the var() resolves to the self-hosted file."
      },
      "mono": {
        "stack": "var(--font-mono, 'IBM Plex Mono'), 'IBM Plex Mono', ui-monospace, monospace",
        "comment": "Node numbers, counts, timestamps, IDs. Tabular figures. Served by next/font (src/lib/styles/fonts.ts); the var() resolves to the self-hosted file."
      }
    },
    "scale": {
      "hero": {
        "mobile": "38px",
        "desktop": "60px",
        "lineHeight": "1.08",
        "face": "display",
        "$comment": "Marketing hero only. The app has no headline this large."
      },
      "display-l": {
        "mobile": "28px",
        "desktop": "36px",
        "lineHeight": "1.2",
        "face": "display"
      },
      "display-m": {
        "mobile": "22px",
        "desktop": "28px",
        "lineHeight": "1.2",
        "face": "display"
      },
      "title": {
        "mobile": "18px",
        "desktop": "20px",
        "lineHeight": "1.3",
        "face": "display"
      },
      "body": {
        "mobile": "15px",
        "desktop": "16px",
        "lineHeight": "1.55",
        "face": "body"
      },
      "label": {
        "mobile": "13px",
        "desktop": "14px",
        "lineHeight": "1.4",
        "face": "body"
      },
      "caption": {
        "mobile": "11px",
        "desktop": "12px",
        "lineHeight": "1.4",
        "face": "body"
      },
      "node-label": {
        "mobile": "13px",
        "desktop": "14px",
        "lineHeight": "1.2",
        "face": "display"
      }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "normal": "0",
      "uppercase": {
        "value": "0.16em",
        "comment": "Applied to every uppercase label"
      }
    }
  },
  "space": {
    "$comment": "4px base. The number is the multiplier. Map geometry uses its own scale (§09) and does not borrow these. 24 and 32 exist only for marketing section rhythm; app chrome never needs a gap that large.",
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px",
    "32": "128px"
  },
  "radius": {
    "$comment": "Deliberately varied. Nothing is 8px everywhere.",
    "chip": "6px",
    "control": "10px",
    "card": "12px",
    "sheet": "20px",
    "pill": "999px",
    "circle": "50%"
  },
  "glow": {
    "$comment": "DESIGN DESCRIPTIONS. In DOM chrome these compile to box-shadow. On canvas they compile to pre-rendered radial-gradient sprites (18 = 6 families x 3 levels), composited additively, and are NEVER emitted as live box-shadow or filter. See §16 implementation rule and §23.",
    "0": {
      "level": 0,
      "spread": "0",
      "alpha": 0,
      "appliesTo": "Inactive, Coming Soon"
    },
    "1": {
      "level": 1,
      "spread": "10px",
      "alpha": 0.35,
      "appliesTo": "Available node, connectors, primary buttons"
    },
    "2": {
      "level": 2,
      "spread": "18px",
      "alpha": 0.55,
      "appliesTo": "Active node"
    },
    "3": {
      "level": 3,
      "spread": "28px",
      "alpha": 0.75,
      "ring": "0 0 0 4px rgba(255,255,255,0.10)",
      "appliesTo": "Selected node, root ring"
    }
  },
  "elevation": {
    "sheet": {
      "value": "0 -1px 0 #22253A, 0 -20px 48px rgba(0,0,0,0.60)",
      "comment": "Darkness, not drop shadow. Sheets float by contrast, not by shadow."
    },
    "card": {
      "value": "none",
      "comment": "Cards are the calm surface. Glow belongs to the map."
    },
    "menu": {
      "value": "0 8px 32px rgba(0,0,0,0.72)"
    }
  },
  "scrim": {
    "value": "rgba(0,0,0,0.68)",
    "blur": "2px",
    "comment": "Pushes the map back without hiding it."
  },
  "motion": {
    "$comment": "Under prefers-reduced-motion every duration collapses to 0.01ms cross-fade, camera moves become instant, ambient breathe stops. Shipped in P1, not P13.",
    "duration": {
      "selection": {
        "value": "140ms",
        "comment": "Immediate feedback beats smooth feedback"
      },
      "collapse": {
        "value": "200ms",
        "comment": "Faster than expansion — retreat should feel decisive"
      },
      "expand": {
        "value": "260ms",
        "stagger": "25ms",
        "comment": "Children emerge FROM the parent position, never fade in place"
      },
      "sheet": {
        "value": "280ms",
        "comment": "Follows the finger on drag"
      },
      "camera": {
        "value": "420ms",
        "comment": "Always animated; a teleporting camera loses the user"
      },
      "breathe": {
        "value": "4000ms",
        "comment": "Root node only. The one ambient animation in the product."
      }
    },
    "easing": {
      "expand": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "collapse": "cubic-bezier(0.4, 0, 0.7, 0.2)",
      "camera": "cubic-bezier(0.25, 0.9, 0.25, 1)",
      "selection": "cubic-bezier(0, 0, 0.2, 1)",
      "sheet": {
        "spring": {
          "damping": 0.82
        },
        "fallback": "cubic-bezier(0.2, 0.9, 0.3, 1)"
      }
    },
    "breatheOpacityDelta": 0.04
  },
  "control": {
    "$comment": "Both sets ship in P1. `touch` is the default below 1024px, `pointer` at and above. §17.",
    "touch": {
      "buttonHeight": "48px",
      "inputHeight": "48px",
