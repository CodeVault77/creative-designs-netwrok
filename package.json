{
  "name": "creative-design-networks",
  "version": "0.1.0",
  "private": true,
  "description": "Creative Design Networks \u2014 a spatial browser. Phase P0 foundation.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run tokens && next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run tokens:check && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky || true",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "verify:map": "node scripts/verify-map.mjs",
    "shoot:map": "node scripts/shoot-map.mjs",
    "verify:node": "node scripts/verify-node.mjs",
    "shoot:node": "node scripts/shoot-node.mjs",
    "verify:editor": "node scripts/verify-editor.mjs",
    "shoot:editor": "node scripts/shoot-editor.mjs",
    "verify:accounts": "node scripts/verify-accounts.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs",
    "verify:sharing": "node scripts/verify-sharing.mjs",
    "verify:search": "node scripts/verify-search.mjs",
    "verify:link": "node scripts/verify-link.mjs",
    "verify:watch": "node scripts/verify-watch.mjs",
    "verify:collab": "node scripts/verify-collab.mjs",
    "verify:enquiry": "node scripts/verify-enquiry.mjs",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:landing": "node scripts/verify-landing.mjs",
    "verify:forms": "node scripts/verify-forms.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.19",
    "undici": "^6.21.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "axe-core": "^4.10.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.4.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "storybook": "^8.6.0",
    "typescript": "^5.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
