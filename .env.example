# ---------------------------------------------------------------------------
# Creative Design Networks — environment contract
#
# Copy to .env.local and adjust. Every variable here is validated at boot by
# src/lib/env.ts; a missing or malformed value crashes the process with a
# message naming the variable rather than failing mysteriously later.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# PUBLIC FOREVER, including in already-deployed builds. Never put a secret
# behind that prefix.
# ---------------------------------------------------------------------------

# Which deployed environment this process is.
# local | preview | staging | production
APP_ENV=local

# Absolute origin. Used to build shareable node links (/n/<id>) and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where analytics events go.
#   console — logs to the browser console (local development)
#   noop    — discards events (tests, and any build where analytics is off)
# A real provider is added in P6; see docs/03-analytics-plan.md for why the
# vendor decision is deliberately deferred.
NEXT_PUBLIC_ANALYTICS_PROVIDER=beacon

# --- Link-to-Mind-Map (§12) -------------------------------------------------
# Optional. Without it the feature falls back to the deterministic heading
# structurer, which is free and needs no network.
ANTHROPIC_API_KEY=
INGEST_MODEL=claude-sonnet-5
# Hard monthly ceiling in USD. Over it, runs degrade to the free path.
INGEST_MONTHLY_USD_CAP=50
# Salt for hashing signed-out callers in the rate limiter. Set a real one.
INGEST_HASH_SALT=change-me-in-every-deployed-environment

# --- Launch (§20 P14) -------------------------------------------------------
# `beacon` writes events to our own database (ADR-0009). Deployed environments
# MUST use it — `console` means every event goes to the browser console and
# nowhere else, which is P14's named High risk.
# `closed` requires an invite code to sign up, capped at 50 accounts.
BETA_MODE=open
# Surfaced by /api/health so a deploy can be identified without guessing.
APP_VERSION=dev

# ---------------------------------------------------------------- email
# `log` prints and reports success — right for development, catastrophic in
# production, so the app REFUSES to start with it when NODE_ENV=production
# rather than silently dropping every message.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Creative Design Networks <noreply@localhost>

# ------------------------------------------------------------ job runner
# Shared secret for POST /api/jobs/drain, which a scheduler calls every minute.
# A scheduler has no session, so it authenticates with this. Leave it unset and
# the endpoint accepts staff sessions only — it never falls open.
# Generate with: openssl rand -hex 24
JOB_RUNNER_TOKEN=

# Payments. Leave blank locally: billing fails loudly rather than pretending
# a checkout succeeded, and nothing else needs them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
